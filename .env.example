# ── Required ──────────────────────────────────────────
# Google Gemini API key — powers the Chaos Copilot AI assistant (/api/ai-chat)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────
# OpenAI API key — legacy chat fallback route (/api/chat)
OPENAI_API_KEY=your_openai_api_key_here

# OnlineCompiler.io API key — server-side code execution (/api/execute)
ONLINE_COMPILER_API_KEY=your_onlinecompiler_api_key_here
